@model TeleTracker.Models.Antena

@{
    ViewData["Title"] = "Registrar Nueva Antena";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="card-title fw-bold mb-0">Registrar Nueva Estación / Antena</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Crear" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Codigo" class="form-label fw-semibold">Código de Estación</label>
                                <input asp-for="Codigo" class="form-control" placeholder="Ej: ANT-PASTO-001" />
                                <span asp-validation-for="Codigo" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Nombre" class="form-label fw-semibold">Nombre de la Antena</label>
                                <input asp-for="Nombre" class="form-control" placeholder="Ej: Nodo Centro" />
                                <span asp-validation-for="Nombre" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Ubicacion" class="form-label fw-semibold">Dirección / Referencia de Ubicación</label>
                                <input asp-for="Ubicacion" class="form-control" placeholder="Ej: Calle 18 #22-10, Pasto" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Latitud" class="form-label fw-semibold">Latitud</label>
                                <input asp-for="Latitud" type="number" step="any" class="form-control" placeholder="Ej: 1.2136" />
                                <span asp-validation-for="Latitud" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Longitud" class="form-label fw-semibold">Longitud</label>
                                <input asp-for="Longitud" type="number" step="any" class="form-control" placeholder="Ej: -77.2811" />
                                <span asp-validation-for="Longitud" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Estado" class="form-label fw-semibold">Estado Operativo</label>
                                <select asp-for="Estado" class="form-select">
                                    <option value="OPERATIVA">OPERATIVA</option>
                                    <option value="MANTENIMIENTO">MANTENIMIENTO</option>
                                    <option value="INACTIVA">INACTIVA</option>
                                </select>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary px-4 fw-semibold">Guardar Antena</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>