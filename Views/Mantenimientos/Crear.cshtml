@model TeleTracker.Models.Mantenimiento

@{
    ViewData["Title"] = "Programar Mantenimiento";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-calendar-plus"></i> Programar Mantenimiento</h4>
        </div>
        <div class="card-body">
            <form asp-action="Crear" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="IdAntena" class="form-label fw-bold">Antena</label>
                    <select asp-for="IdAntena" class="form-select" asp-items="ViewBag.Antenas">
                        <option value="">-- Seleccione una Antena --</option>
                    </select>
                    <span asp-validation-for="IdAntena" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="IdUsuario" class="form-label fw-bold">Técnico Asignado</label>
                    <select asp-for="IdUsuario" class="form-select" asp-items="ViewBag.Tecnicos">
                        <option value="">-- Seleccione un Técnico --</option>
                    </select>
                    <span asp-validation-for="IdUsuario" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Tipo" class="form-label fw-bold">Tipo de Mantenimiento</label>
                    <select asp-for="Tipo" class="form-select">
                        <option value="Preventivo">Preventivo</option>
                        <option value="Correctivo">Correctivo</option>
                    </select>
                    <span asp-validation-for="Tipo" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FechaProgramada" class="form-label fw-bold">Fecha y Hora Programada</label>
                    <input asp-for="FechaProgramada" type="datetime-local" class="form-control" />
                    <span asp-validation-for="FechaProgramada" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label fw-bold">Descripción / Observaciones</label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Detalle las tareas a realizar..."></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between pt-2">
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-success">Guardar Mantenimiento</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}